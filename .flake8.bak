[flake8]
max-line-length = 119
extend-ignore =
    E203,
    W503,
    D100,
    D101,
    D102,
    D103,
    D104,
    D105,
    D106,
    D107,
    D200,
    D204,
    D205,
    D212,
    D213,
    D400,
    D401,
    D404,
    D406,
    D407,
    D408,
    D409,
    D410,
    D411,
    D412,
    D413,
    D414,
    D415,
    D416
docstring-convention = pep257
exclude = .git,__pycache__,venv,.venv